{
  "name": "shellgeiai",
  "version": "0.5.0",
  "description": "ShellGeiAI is a local CLI that generates, runs, and verifies shell one-liners safely.",
  "type": "module",
  "author": "amanoese",
  "bin": {
    "shellgeiai": "dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p test/tsconfig.json",
    "dev": "npm run build && node dist/cli.js",
    "knowledge:man": "npm run build && node scripts/build-man-knowledge.js",
    "start": "npm run build && node dist/cli.js",
    "lint": "echo \"TODO: add lint\"",
    "test": "npm run build && vitest run",
    "test:docker": "npm run build && vitest run test/dockerIntegration.test.js",
    "test:watch": "npm run build && vitest",
    "prepack": "npm run build"
  },
  "keywords": [
    "shellgei",
    "cli",
    "shell",
    "ai",
    "docker",
    "openai",
    "javascript"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amanoese/shellgeiai.git"
  },
  "homepage": "https://github.com/amanoese/shellgeiai#readme",
  "bugs": {
    "url": "https://github.com/amanoese/shellgeiai/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "scripts",
    "wasm",
    "policies",
    "data",
    "!data/knowledge/man.jsonl",
    "!data/knowledge/man.vectors.jsonl",
    "!data/knowledge/man.vectors.json",
    "!**/*.sqlite",
    "!**/*.sqlite-*",
    "!**/*.sqlite3",
    "!**/*.sqlite3-*",
    "!**/*.db",
    "!**/*.db-*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "commander": "^15.0.0",
    "log-update": "^8.0.0",
    "openai": "^6.9.1",
    "sqlite-vec": "0.1.9",
    "web-tree-sitter": "^0.26.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "tree-sitter-bash": "^0.25.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  }
}
